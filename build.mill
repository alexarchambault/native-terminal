//| mill-version: 1.3.1
//| mill-jvm-opts:
//| - -Xmx2g
//| mvnDeps:
//| - com.github.lolgab::mill-mima_mill1:0.2.2
//| - io.get-coursier:interface:1.0.29

import com.github.lolgab.mill.mima.{Mima, ProblemFilter}
import mill.*
import mill.api.BuildCtx
import mill.javalib.*
import mill.javalib.publish.*

import java.util.Locale

import scala.util.Properties

object Versions {

  /** The version to publish, from the 'v*' git tags.
    *
    * If HEAD has a 'v*' tag, the version is the value after its 'v'. Else, the version is the
    * latest 'v*' tag value, cut to its first 3 elements, with the last one bumped, and a
    * '-SNAPSHOT' suffix (e.g. 'v0.0.9.1' → '0.0.10-SNAPSHOT').
    */
  def publishVersion(): String = {
    def git(args: String*): String =
      os.proc("git", args).call(cwd = BuildCtx.workspaceRoot, check = false).out.trim()
    git("tag", "--list", "v*", "--points-at", "HEAD").linesIterator.toList.headOption match {
      case Some(tag) => tag.stripPrefix("v")
      case None =>
        val latest = git("describe", "--tags", "--abbrev=0", "--match", "v*").stripPrefix("v")
        val elems  = latest.split('.').take(3)
        elems.lastOption.flatMap(_.toIntOption) match {
          case Some(last) => (elems.init :+ (last + 1).toString).mkString(".") + "-SNAPSHOT"
          case None       => "0.0.1-SNAPSHOT"
        }
    }
  }
}

trait NativeTerminalPublishModule extends NativeTerminalJavaModule with PublishModule with Mima {
  def pomSettings = PomSettings(
    description = artifactName(),
    organization = "io.github.alexarchambault.native-terminal",
    url = "https://github.com/alexarchambault/native-terminal",
    licenses = Seq(
      License.`Apache-2.0`,
      License.`GPL-2.0-with-classpath-exception`
    ),
    versionControl = VersionControl.github("alexarchambault", "native-terminal"),
    developers = Seq(
      Developer("alexarchambault", "Alex Archambault", "https://github.com/alexarchambault")
    )
  )
  def publishVersion = Task.Input {
    Versions.publishVersion()
  }

  // Almost empty javadoc JARs, with only a manifest in them
  def docJar = Task {
    val jar = Task.dest / "out.jar"
    mill.util.Jvm.createJar(jar, Seq.empty)
    PathRef(jar)
  }

  /** First version of this module published on Maven Central.
    *
    * Some 'v*' tags predate that (or were never published at all), so MiMa can't check against
    * them.
    */
  def mimaFirstVersion: String

  def mimaPreviousVersions: T[Seq[String]] = Task.Input {
    val current = os.proc("git", "describe", "--tags", "--match", "v*")
      .call(cwd = BuildCtx.workspaceRoot)
      .out.trim()
    val firstVersion = coursier.version.Version(mimaFirstVersion)
    os.proc("git", "tag", "-l")
      .call(cwd = BuildCtx.workspaceRoot)
      .out.lines()
      .filter(_ != current)
      .filter(_.startsWith("v"))
      .filter(!_.contains("-"))
      .map(_.stripPrefix("v"))
      .map(coursier.version.Version(_))
      .filter(_ >= firstVersion)
      .sorted
      .map(_.repr)
  }
}

trait NativeTerminalJavaModule extends JavaModule {
  def jvmRelease: T[String] = Task.Input("8")
  private def isArm64 =
    Option(System.getProperty("os.arch")).map(_.toLowerCase(Locale.ROOT)) match {
      case Some("aarch64" | "arm64") => true
      case _                         => false
    }
  def javacSystemJvmId = Task {
    if (Properties.isMac && isArm64) s"zulu:${jvmRelease()}"
    else if (Properties.isWin && isArm64)
      if (jvmRelease() == "8") "https://github.com/adoptium/temurin8-binaries/releases/download/jdk8u442-b06/OpenJDK8U-jdk_x64_windows_hotspot_8u442b06.zip"
      else s"liberica:${jvmRelease()}"
    else s"adoptium:${jvmRelease()}"
  }
  def javacSystemJvm = Task {
    val javaHome = os.Path(coursierapi.JvmManager.create().get(javacSystemJvmId()))
    PathRef(javaHome, quick = true)
  }
  // adds options equivalent to --release ${jvmRelease()} + allowing access to unsupported JDK APIs
  // (no more straightforward options to achieve that AFAIK)
  def maybeJdkReleaseJavacOpt = Task {
    val javaHome   = javacSystemJvm().path
    val rtJar      = javaHome / "jre/lib/rt.jar"
    val hasModules = os.isDir(javaHome / "jmods")
    val hasRtJar   = os.isFile(rtJar)
    assert(hasModules || hasRtJar)
    if (hasModules)
      Seq("--release", jvmRelease()) // FIXME javacSystemJvm is unused here
    else
      Seq("-source", jvmRelease(), "-target", jvmRelease(), "-bootclasspath", rtJar.toString)
  }
  def javacOptions = Task {
    super.javacOptions() ++ maybeJdkReleaseJavacOpt()
  }
}

object native extends JavaModule with NativeTerminalPublishModule {
  def artifactName     = "native-terminal"
  def mimaFirstVersion = "0.0.7"
  def mvnDeps = Seq(
    mvn"io.github.alexarchambault:is-terminal:0.1.2",
    // jline-native 4.x requires Java 11 (see .scala-steward.conf)
    mvn"org.jline:jline-native:3.30.17"
  )
  // Provides org.graalvm.nativeimage.* and com.oracle.svm.core.annotate.*, for
  // SigWinchNativeWindows (only used when building native images)
  def compileMvnDeps = Seq(
    mvn"org.graalvm.sdk:nativeimage:25.5.5.0.3"
  )

  def jdk22ClassesResources = Task {
    val destDir = Task.dest / "META-INF/versions/22"
    os.makeDir.all(destDir)
    for (elem <- os.list(jdk22.compile().classes.path))
      os.copy(elem, destDir / elem.last)
    PathRef(Task.dest)
  }

  def resources = Task {
    super.resources() ++ Seq(jdk22ClassesResources())
  }
  def manifest = Task {
    super.manifest().add("Multi-Release" -> "true")
  }

  object jdk22 extends NativeTerminalJavaModule {
    def jvmRelease: T[String] = Task.Input("22")
    def moduleDeps = Seq(native)
  }

  object test extends JavaTests with TestModule.Junit5 {
    def jupiterVersion = "5.14.4"
    def mvnDeps = super.mvnDeps() ++ Seq(
      // to read the native image metadata in NativeImageMetadataTests (Jackson 2.x supports Java 8)
      mvn"com.fasterxml.jackson.core:jackson-databind:2.22.4"
    )

    /** JVM to run the tests with, as a coursier JVM id (e.g. 'zulu:11') or a Java home path.
      *
      * Defaults to the JVM Mill runs on.
      */
    def testJvm = Task.Input {
      Task.env.get("NATIVE_TERMINAL_TEST_JVM").map(_.trim).filter(_.nonEmpty)
    }
    def javaHome = Task {
      testJvm() match {
        case Some(id) =>
          val path = resolveJvm(id, Task.ctx(), coursierCacheCustomizer())
          Some(PathRef(path, quick = true))
        case None =>
          super.javaHome()
      }
    }

    /** Java home of a JVM, from a coursier JVM id (e.g. 'zulu:11') or a Java home path */
    private def resolveJvm(
        id: String,
        ctx: mill.api.TaskCtx,
        coursierCacheCustomizer: Option[coursier.cache.FileCache[coursier.util.Task] => coursier.cache.FileCache[coursier.util.Task]]
    ): os.Path = {
      val asPath = scala.util.Try(os.Path(id, BuildCtx.workspaceRoot)).toOption
        .filter(os.isDir(_))
      asPath.getOrElse {
        mill.util.Jvm.resolveJavaHome(
          id = id,
          ctx = Some(ctx),
          coursierCacheCustomizer = coursierCacheCustomizer
        ).get
      }
    }

    /** Runs the tests with the JUnit console launcher, on the JVM with the passed id or path
      * (see testJvm).
      *
      * Unlike 'test', this works on Java 8, which Mill's test runner doesn't support. The tests
      * are compiled with the JVM Mill runs on (or the one of NATIVE_TERMINAL_TEST_JVM, if set).
      */
    def consoleTest(jvm: String) = Task.Command {
      val javaHome = resolveJvm(jvm, Task.ctx(), coursierCacheCustomizer())
      // JUnit Platform 1.x versions go along JUnit Jupiter 5.x ones
      val platformVersion = "1." + jupiterVersion().stripPrefix("5.")
      val console = defaultResolver().classpath(
        Seq(mvn"org.junit.platform:junit-platform-console:$platformVersion")
      )
      val classPath = (runClasspath() ++ console).map(_.path).distinct
      os.proc(
        javaHome / "bin/java",
        "-cp",
        classPath.mkString(java.io.File.pathSeparator),
        "org.junit.platform.console.ConsoleLauncher",
        "execute",
        "--disable-banner",
        "--fail-if-no-tests",
        "--scan-class-path",
        compile().classes.path.toString
      ).call(stdin = os.Inherit, stdout = os.Inherit, stderr = os.Inherit)
      ()
    }

    /** Builds a native image of TtyCheck, with the GraalVM with the passed id or path (see
      * testJvm), and the passed native-image options.
      *
      * The image is written at 'tty-check' (or 'tty-check.exe' on Windows) in the 'dest'
      * directory of this command. Like TtyCheck itself, it needs to be run from a terminal.
      */
    def ttyCheckNativeImage(graalvm: String, options: String*) = Task.Command {
      val javaHome = resolveJvm(graalvm, Task.ctx(), coursierCacheCustomizer())
      val nativeImage =
        if (Properties.isWin) javaHome / "bin/native-image.cmd"
        else javaHome / "bin/native-image"
      val dest = Task.dest / "tty-check"
      os.proc(
        nativeImage,
        options,
        "-cp",
        runClasspath().map(_.path).mkString(java.io.File.pathSeparator),
        "-o",
        dest,
        "io.github.alexarchambault.nativeterm.TtyCheck"
      ).call(cwd = Task.dest, stdin = os.Inherit, stdout = os.Inherit, stderr = os.Inherit)
      PathRef(if (Properties.isWin) Task.dest / "tty-check.exe" else dest)
    }

    // Run the tests against the native-terminal JAR rather than its class directory, so that
    // the multi-release JAR mechanism kicks in, and the FFM classes are used on Java >= 22
    def runClasspath = Task {
      val nativeLocalCp = native.localRunClasspath().toSet
      super.runClasspath().filterNot(nativeLocalCp) ++ Seq(native.jar())
    }
  }
}
